function createTreatment($data) {
    global $db;

    $sql = "INSERT INTO treatment(treatment_type, treatment_dr_id, patient_id, treatment_category_treatment_id) 
            VALUES ('$data[treatment_type]', '$data[treatment_dr_id]', '$data[patient_id]', '$data[treatment_category_treatment_id]')";

    $result = $db->query($sql);

    if ($result) {
        echo "Record inserted.";
    }
    else {
        echo "Failed to insert record.";
    }
}

